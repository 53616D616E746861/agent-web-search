{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "document v0.1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string"
    },
    "source_id": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "published_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "fetched_at": {
      "type": "string"
    },
    "authorship": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "agent",
            "mixed",
            "human",
            "unknown"
          ]
        },
        "evidence": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "evidence"
      ]
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "heading": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "links": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "heading",
          "text",
          "links"
        ]
      }
    }
  },
  "required": [
    "id",
    "source_id",
    "url",
    "title",
    "published_at",
    "fetched_at",
    "authorship",
    "sections"
  ]
}
