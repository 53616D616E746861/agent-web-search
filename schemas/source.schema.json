{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "source v0.2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "evidence": {
      "type": "string"
    },
    "scope": {
      "description": "What the evidence vouches for. 'site': the site as a whole, never each document on it.",
      "enum": [
        "site"
      ]
    },
    "registry": {
      "description": "Where the source came from: the registry, when its snapshot was saved, and its original record unchanged.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "observed_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "record": {
          "type": "object"
        }
      },
      "required": [
        "name",
        "url",
        "observed_at",
        "record"
      ]
    }
  },
  "required": [
    "id",
    "url",
    "name",
    "evidence"
  ]
}
